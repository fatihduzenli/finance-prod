# Copy to .env for local development. Never commit .env (it is git-ignored).
# Every value here is intentionally empty: this file documents names only
# (root CLAUDE.md §5.3). In staging and production these come from Azure Key Vault
# through the container app's managed identity, never from a file.
#
# The environment is validated at Django settings import time
# (backend/finance/env_guard.py). A bad or missing value exits the process instead of
# starting with a configuration that could move real money.

# --- Application environment --------------------------------------------
# One of: local | staging | production. Required.
APP_ENV=
# Base URL this deployment is reached at, e.g. https://staging.example.com.
# Required: it drives ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS. Locally
# http://localhost:8000.
APP_BASE_URL=
# 0 or 1. Optional, defaults to 0, and forced to 0 unless APP_ENV=local.
DJANGO_DEBUG=
# Django signing key. Required, secret, no fallback.
DJANGO_SECRET_KEY=

# --- Stax ---------------------------------------------------------------
# Exactly sandbox or live. Required in every APP_ENV. live is only accepted when
# APP_ENV=production (docs/CLAUDE.md Rule 6).
STAX_ENV=
# Merchant API key for the environment above. Required in staging and production;
# may be empty locally, where no Stax call is made. Secret.
STAX_API_KEY=
# Must be exactly https://apiprod.fattlabs.com outside local; local may point at a
# fake. Required.
STAX_API_BASE_URL=
# Secret path segment for inbound webhooks: 64+ URL-safe characters. Required in
# staging and production (docs/CLAUDE.md Rule 4). Secret.
STAX_WEBHOOK_URL_TOKEN=
# none (default when empty) or worker; only the one process that owns the Stax rate-limit bucket sets worker.
STAX_CALLER=
# true or false (default when empty); enables the pay-an-invoice call, off until the owner decides TODO-VERIFY-019.
STAX_PAY_INVOICE_ENABLED=
# Merchant ID the Stax key must belong to; checked by provider_ping and, at image start, by provider_environment_check; empty means not checked.
STAX_EXPECTED_MERCHANT_ID=
# stax (default when empty) or fake. fake is the in-memory provider for local
# development and is refused unless APP_ENV=local; it makes no network call.
STAX_PROVIDER=
# Debits above this amount show a warning on the autopay enrolment and rent run screens. A
# positive amount with at most two decimals; 2000.00 when empty. A placeholder until
# Stax states the per-transaction limit (PLAN-007 §4.3, SCOPE Q25). Not a secret.
LARGE_DEBIT_WARNING_AMOUNT=
# The ACH per-transaction limit confirmed by Stax for this environment (PLAN-007c, SCOPE Q25).
# A positive amount with at most two decimals; empty means unknown. When set, a debit above
# it cannot be enrolled in autopay, whatever is confirmed. Not a secret.
STAX_MAX_TXN_AMOUNT=
# Stax sandbox API key read only by the sandbox test suites (pytest -m sandbox). Secret.
STAX_SANDBOX_API_KEY=

# --- Reconciliation (PLAN-010 D12) -----------------------------------------
# All optional; empty means the default named here. A value that is not valid aborts
# the start. None is a secret.
# Pending payments older than this many US business days (weekends excluded) are
# flagged. Whole number 1 to 60; default 5.
PENDING_PAYMENT_MAX_BUSINESS_DAYS=
# The first run reads transactions from this many days back. 1 to 364; default 35.
RECONCILE_LOOKBACK_DAYS=
# Each later run re-reads from this many hours before the last successful run.
# 0 to 720; default 48.
RECONCILE_OVERLAP_HOURS=
# Deposits are listed and matched for this many days back. 1 to 364; default 14.
RECONCILE_DEPOSIT_DAYS=
# The scheduled run starts at this local time, HH:MM; default 02:00.
RECONCILE_LOCAL_TIME=
# ... in this IANA time zone; default America/New_York.
RECONCILE_TIMEZONE=

# --- Data stores --------------------------------------------------------
# Required. A sqlite scheme is accepted only when APP_ENV=local; deployed
# environments must use postgres.
DATABASE_URL=
# Optional until Celery arrives (Step 10).
REDIS_URL=

# --- Documents (PLAN-010c D1, D2) ------------------------------------------
# None is a secret. Blob endpoint of the document storage account, e.g.
# https://<account>.blob.core.windows.net/; empty turns the documents feature off
# outside local (local uses in-memory storage).
DOCUMENTS_STORAGE_ACCOUNT_URL=
# Private blob container that holds the documents; documents when empty.
DOCUMENTS_CONTAINER=
# Client ID of the user-assigned managed identity used for Blob Storage; an identifier, required when the URL above is set.
AZURE_CLIENT_ID=

# --- Reports (PLAN-010c D11) ----------------------------------------------
# PostgreSQL statement timeout for the P&L page and export, in milliseconds, 1000 to 120000; 15000 when empty. Not a secret.
REPORT_STATEMENT_TIMEOUT_MS=

# --- Outbound mail (PLAN-011b D3, D4) ---------------------------------------
# true or false (default when empty). When true the collection e-mails are sent through
# the Gmail API, and GMAIL_SENDER and GMAIL_SERVICE_ACCOUNT_JSON are required (and
# MAIL_CATCH_ALL unless APP_ENV=production). Not a secret.
MAIL_ENABLED=
# The company mailbox the e-mails are sent as (domain-wide delegation). An address, not a secret.
GMAIL_SENDER=
# The Gmail service-account key, the whole JSON key file. Secret: in staging and production it
# comes from the Key Vault secret gmail-service-account-key by container-app reference, never
# from a file; never paste it here. Leave empty locally (local runs use the in-memory sender).
GMAIL_SERVICE_ACCOUNT_JSON=
# A staff address that receives every e-mail instead of the operator, with the real recipient
# in the subject; required when MAIL_ENABLED is true and APP_ENV is not production. Not a secret.
MAIL_CATCH_ALL=
# The {company} merge field of the e-mails; Global Retail Groups when empty. Not a secret.
COMPANY_NAME=
# Time zone: not a setting. The app runs in America/New_York (PLAN-011b D1) and stores UTC;
# every "today", due date and report month is a New York date.

# --- Monitoring ---------------------------------------------------------
# Optional. Empty means Sentry is off. When set, events are scrubbed before send
# (backend/finance/sentry.py).
SENTRY_DSN=

# --- Local development only ---------------------------------------------
# Password for the seeded local admin (admin@example.com), read only by
# `python backend/manage.py seed_local_admin`, which refuses to run unless
# APP_ENV=local. No default: the command fails when this is empty. Never set it
# in staging or production.
LOCAL_ADMIN_PASSWORD=
